# ---- Required ----
# Postgres connection string (Supabase or Neon in production; local Postgres for development)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mpj
# Long random secret for sign-in cookies (32+ characters). Generate: openssl rand -base64 48
SESSION_SECRET=
# Public address of the site (used for SEO links, sitemap and share previews)
NEXT_PUBLIC_SITE_URL=https://www.myprivate-jet.com
# First advisor account, created by `npm run db:seed`
ADVISOR_EMAIL=
ADVISOR_PASSWORD=

# ---- SMS verification (Twilio Verify) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ---- Card payments (Stripe) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Email (Resend) ----
RESEND_API_KEY=
EMAIL_FROM="MyPrivate-Jet <office@myprivate-jet.com>"

# ---- AI for the advisor desk (Anthropic) ----
ANTHROPIC_API_KEY=

# ---- Analytics (optional) ----
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA_ID=

# Set to true only on a staging site to allow simulated SMS/payments in production builds
ALLOW_SIMULATIONS=
